s/connectors/introduction"},"295":{"id":"/docs/connectors/introduction-0","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#architecture","content":"Architecture"},"296":{"id":"/docs/connectors/introduction-1","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#data-flow","content":"Data Flow"},"297":{"id":"/docs/connectors/introduction-2","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#available-connectors","content":"Available Connectors"},"298":{"id":"/docs/connectors/introduction-3","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transforms","content":"Transforms"},"299":{"id":"/docs/connectors/introduction-4","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#supported-schemas","content":"Supported Schemas"},"300":{"id":"/docs/connectors/introduction-5","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#features","content":"Features"},"301":{"id":"/docs/connectors/introduction-6","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#quick-start","content":"Quick Start"},"302":{"id":"/docs/connectors/introduction-7","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#configuration","content":"Configuration"},"303":{"id":"/docs/connectors/introduction-8","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#runtime","content":"Runtime"},"304":{"id":"/docs/connectors/introduction-9","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#sink","content":"Sink"},"305":{"id":"/docs/connectors/introduction-10","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#source","content":"Source"},"306":{"id":"/docs/connectors/introduction-11","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#building-the-connectors","content":"Building the connectors"},"307":{"id":"/docs/connectors/introduction-12","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transformations","content":"Transformations"},"308":{"id":"/docs/connectors/introduction-13","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The highly performant and modular runtime for statically typed, yet dynamically loaded connectors. Ingest the data from the external sources and push it further to the Iggy streams, or fetch the data from the Iggy streams and push it further to the external sources. Create your own Rust plugins by simply implementing either the Source or Sink trait and build custom pipelines for the data processing."},"309":{"id":"/docs/connectors/introduction-14","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect."},"310":{"id":"/docs/connectors/introduction-15","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#architecture","content":"Connectors are dynamically loaded shared libraries (.so on Linux, .dylib on macOS, .dll on Windows) loaded at runtime via dlopen2. Data crossing the FFI boundary between the runtime and plugins is serialized using postcard, a compact binary format. Each plugin receives its own Tokio runtime inside the SDK, ensuring isolation."},"311":{"id":"/docs/connectors/introduction-16","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"The connector runtime operates in two directions - source (ingest) and sink (egress):"},"312":{"id":"/docs/connectors/introduction-17","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Key details:"},"313":{"id":"/docs/connectors/introduction-18","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Transforms run inside the runtime process, not inside the plugins. They are applied after decoding for sources (before sending to Iggy) and after consuming from Iggy for sinks (before forwarding to the external system)."},"314":{"id":"/docs/connectors/introduction-19","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"State persistence is file-based (using MessagePack serialization) and applies to source connectors only, tracking the last polled position."},"315":{"id":"/docs/connectors/introduction-20","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Consumer groups handle offset tracking for sink connectors automatically, so sinks do not need to manage their own offsets."},"316":{"id":"/docs/connectors/introduction-21","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Type"},"317":{"id":"/docs/connectors/introduction-22","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Connectors"},"318":{"id":"/docs/connectors/introduction-23","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Source"},"319":{"id":"/docs/connectors/introduction-24","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"PostgreSQL, Elasticsearch, Random"},"320":{"id":"/docs/connectors/introduction-25","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Sink"},"321":{"id":"/docs/connectors/introduction-26","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"PostgreSQL, MongoDB, Elasticsearch, Quickwit, Apache Iceberg, Stdout"},"322":{"id":"/docs/connectors/introduction-27","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"The following built-in transforms are available:"},"323":{"id":"/docs/connectors/introduction-28","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"add_fields - add new fields to the message payload."},"324":{"id":"/docs/connectors/introduction-29","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"delete_fields - remove existing fields from the message payload."},"325":{"id":"/docs/connectors/introduction-30","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"filter_fields - keep only the specified fields, removing everything else."},"326":{"id":"/docs/connectors/introduction-31","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"update_fields - update existing fields with computed values such as timestamp_millis or uuid_v7."},"327":{"id":"/docs/connectors/introduction-32","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#supported-schemas","content":"Messages can be decoded and encoded using the following formats: JSON, Raw bytes, Text, Protocol Buffers, and FlatBuffers."},"328":{"id":"/docs/connectors/introduction-33","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"High Performance: Utilizes Rust's performance characteristics to ensure fast data ingestion and egress."},"329":{"id":"/docs/connectors/introduction-34","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Low memory footprint: Designed with memory efficiency in mind, minimizing the memory footprint of the connectors."},"330":{"id":"/docs/connectors/introduction-35","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Modular Design: Designed with modularity in mind, allowing for easy extension and customization."},"331":{"id":"/docs/connectors/introduction-36","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Dynamic Loading: Supports dynamic loading of plugins, allowing integration with various data sources and sinks at runtime."},"332":{"id":"/docs/connectors/introduction-37","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Statically Typed: Ensures type safety and compile-time checks, reducing runtime errors."},"333":{"id":"/docs/connectors/introduction-38","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Easy Customization: Provides a simple interface for implementing custom connectors, making it easy to create new plugins."},"334":{"id":"/docs/connectors/introduction-39","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Data transformation: Supports data transformation with the help of existing functions."},"335":{"id":"/docs/connectors/introduction-40","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Powerful configuration: Define your sinks, sources, and transformations in the configuration file or fetch them from a remote HTTP API."},"336":{"id":"/docs/connectors/introduction-41","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Flexible configuration providers: Support for local file-based and HTTP-based configuration providers for centralized configuration management."},"337":{"id":"/docs/connectors/introduction-42","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Build the project in release mode (or debug, and update the connectors paths in the config accordingly), and make sure that the plugins specified in core/connectors/runtime/example_config/connectors/ directory under path are available. The configuration must be provided in toml format."},"338":{"id":"/docs/connectors/introduction-43","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run docker compose up -d from /examples/rust/src/sink-data-producer which will start the Quickwit server to be used by an example sink connector. At this point, you can access the Quickwit UI at http://localhost:7280 - check this dashboard again later on, after the events index will be created."},"339":{"id":"/docs/connectors/introduction-44","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Set environment variable IGGY_CONNECTORS_CONFIG_PATH=core/connectors/runtime/example_config/config.toml (adjust the path as needed) pointing to the runtime configuration file."},"340":{"id":"/docs/connectors/introduction-45","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the Iggy server and invoke the following commands via Iggy CLI to create the example streams and topics used by the sample connectors."},"341":{"id":"/docs/connectors/introduction-46","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Execute cargo run --example sink-data-producer -r which will start the example data producer application, sending the messages to previously created qw stream and records topic (this will be used by the Quickwit sink connector)."},"342":{"id":"/docs/connectors/introduction-47","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the connector runtime cargo run --bin iggy-connectors -r - you should be able to browse Quickwit UI with records being constantly added to the events index. At the same time, you should see the new messages being added to the example stream and topic1 topic by the test source connector - you can use Iggy Web UI to browse the data. The messages will have applied the basic fields transformations."},"343":{"id":"/docs/connectors/introduction-48","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"The same rules applies when it comes to overringing the configuration via environment variables as for the main Iggy server."},"344":{"id":"/docs/connectors/introduction-49","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"You can provide the following envs during the runtime startup:"},"345":{"id":"/docs/connectors/introduction-50","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Any configuration section can be overriden with IGGY_CONNECTORS_ prefix, followed by the section name and the key name, e.g. IGGY_CONNECTORS_IGGY_USERNAME."},"346":{"id":"/docs/connectors/introduction-51","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#runtime","content":"All the connectors are implemented as Rust libraries and can be used as a part of the connector runtime. The runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run. For more information, please refer to the runtime documentation."},"347":{"id":"/docs/connectors/introduction-52","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Sinks are responsible for consuming the messages from the configured stream(s) and topic(s) and sending them further to the specified destination. For example, the Quickwit sink connector is responsible for sending the messages to the Quickwit indexer."},"348":{"id":"/docs/connectors/introduction-53","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Please refer to the Sink documentation for the details about the configuration and the sample implementation."},"349":{"id":"/docs/connectors/introduction-54","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"When implementing Sink, make sure to use the sink_connector! macro to expose the FFI interface and allow the connector runtime to register the sink with the runtime.\nEach sink should have its own, custom configuration, which is passed along with the unique plugin ID via expected new() method."},"350":{"id":"/docs/connectors/introduction-55","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Sources are responsible for producing the messages to the configured stream(s) and topic(s). For example, the Test source connector will generate the random messages that will be then sent to the configured stream and topic."},"351":{"id":"/docs/connectors/introduction-56","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Please refer to the Source documentation for the details about the configuration and the sample implementation."},"352":{"id":"/docs/connectors/introduction-57","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#building-the-connectors","content":"New connector can be built simply by implementing either Sink or Source trait. Please check the sink or source documentation, as well as the existing examples under /sinks and /sources directories."},"353":{"id":"/docs/connectors/introduction-58","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"Field transformations (depending on the supported payload formats) can be applied to the messages either before they are sent to the specified topic (e.g. when produced by the source connectors), or before consumed by the sink connectors. To add the new transformation, simply implement the Transform trait and extend the existing load function. Each transform may have its own, custom configuration."},"354":{"id":"/docs/connectors/introduction-59","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"To find out more about the transforms, stream decoders or encoders, please refer to the SDK documentation."},"355":{"id":"/docs/connectors/runtime","page_id":"/docs/connectors/runtime","type":"page","content":"Runtime","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/runtime"},"356":{"id":"/docs/connectors/runtime-0","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-providers","content":"Configuration Providers"},"357":{"id":"/docs/connectors/runtime-1","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#local-file-provider","content":"Local File Provider"},"358":{"id":"/docs/connectors/runtime-2","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-configuration-provider","content":"HTTP Configuration Provider"},"359":{"id":"/docs/connectors/runtime-3","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-options","content":"Configuration Options"},"360":{"id":"/docs/connectors/runtime-4","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#default-url-templates","content":"Default URL Templates"},"361":{"id":"/docs/connectors/runtime-5","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-api","content":"HTTP API"},"362":{"id":"/docs/connectors/runtime-6","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run."},"363":{"id":"/docs/connectors/runtime-7","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The runtime uses a shared Tokio runtime to manage the asynchronous tasks and events across all connectors. Additionally, it has built-in support for logging via tracing crate."},"364":{"id":"/docs/connectors/runtime-8","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The connector are implemented as Rust libraries, and these are loaded dynamically during the runtime initialization process."},"365":{"id":"/docs/connectors/runtime-9","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Internally, dlopen2 provides a safe and efficient way of loading the plugins via C FFI."},"366":{"id":"/docs/connectors/runtime-10","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"By default, runtime will look for the configuration file, to decide which connectors to load and how to configure them."},"367":{"id":"/docs/connectors/runtime-11","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"To start the connector runtime, simply run cargo run --bin iggy-connectors."},"368":{"id":"/docs/connectors/runtime-12","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect."},"369":{"id":"/docs/connectors/runtime-13","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The minimal viable configuration requires at least the Iggy credentials to create 2 separate instances of producer & consumer connections, the state directory path where source connectors can store their optional state, and the connectors configuration provider settings."},"370":{"id":"/docs/connectors/runtime-14","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The path to the configuration can be overridden by IGGY_CONNECTORS_CONFIG_PATH environment variable. Each configuration section can be also additionally updated by using the following convention IGGY_CONNECTORS_SECTION_NAME.KEY_NAME e.g. IGGY_CONNECTORS_IGGY_USERNAME and so on."},"371":{"id":"/docs/connectors/runtime-15","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-providers","content":"The runtime supports two types of configuration providers for managing connector configurations:"},"372":{"id":"/docs/connectors/runtime-16","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"The default configuration provider reads connector configurations from local files. Each connector (source or sink) is configured in its own separate file within the directory specified by connectors.config_dir. If config_dir is empty or the directory doesn't exist, no connectors will be loaded."},"373":{"id":"/docs/connectors/runtime-17","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-configuration-provider","content":"The HTTP configuration provider allows the runtime to fetch connector configurations from a remote HTTP/REST API. This enables centralized configuration management and dynamic configuration updates."},"374":{"id":"/docs/connectors/runtime-18","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"base_url (required): Base URL of the configuration API endpoint"},"375":{"id":"/docs/connectors/runtime-19","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"timeout (optional): HTTP request timeout (default: 10s)"},"376":{"id":"/docs/connectors/runtime-20","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"request_headers (optional): Custom headers to include in all HTTP requests (e.g., authentication headers)"},"377":{"id":"/docs/connectors/runtime-21","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"url_templates (optional): Custom URL templates for API endpoints. Supports variable substitution with {key} and {version} placeholders."},"378":{"id":"/docs/connectors/runtime-22","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.data_path (optional): JSON path to extract response data from nested structures (e.g., \"data.config\")"},"379":{"id":"/docs/connectors/runtime-23","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.error_path (optional): JSON path to check for errors in responses"},"380":{"id":"/docs/connectors/runtime-24","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"If not customized, the HTTP provider uses the following RESTful URL patterns:"},"381":{"id":"/docs/connectors/runtime-25","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create sink config: POST {base_url}/sinks/{key}/configs"},"382":{"id":"/docs/connectors/runtime-26","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create source config: POST {base_url}/sources/{key}/configs"},"383":{"id":"/docs/connectors/runtime-27","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active configs: GET {base_url}/configs/active"},"384":{"id":"/docs/connectors/runtime-28","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active versions: GET {base_url}/configs/active/versions"},"385":{"id":"/docs/connectors/runtime-29","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active sink version: PUT {base_url}/sinks/{key}/configs/active"},"386":{"id":"/docs/connectors/runtime-30","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active so