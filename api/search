s/connectors/sources/random#plugin-config-options","content":"256"},"1943":{"id":"/docs/connectors/sources/random-22","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Size of each generated payload in bytes"},"1944":{"id":"/docs/connectors/sources/source","page_id":"/docs/connectors/sources/source","type":"page","content":"Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/source"},"1945":{"id":"/docs/connectors/sources/source-0","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#overview","content":"Overview"},"1946":{"id":"/docs/connectors/sources/source-1","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#configuration","content":"Configuration"},"1947":{"id":"/docs/connectors/sources/source-2","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Environment Variable Overrides"},"1948":{"id":"/docs/connectors/sources/source-3","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#sample-implementation","content":"Sample implementation"},"1949":{"id":"/docs/connectors/sources/source-4","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"Source connectors are responsible for ingesting data from external sources into Apache Iggy. They provide a way to integrate Apache Iggy with various data sources, such as databases, message queues, or file systems."},"1950":{"id":"/docs/connectors/sources/source-5","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"The source is represented by the single Source trait, which defines the basic interface for all source connectors. It provides methods for initializing the source, reading data from it, and closing the source."},"1951":{"id":"/docs/connectors/sources/source-6","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Each source connector is configured in its own separate configuration file within the connectors directory specified in the main runtime config."},"1952":{"id":"/docs/connectors/sources/source-7","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Main runtime config (config.toml):"},"1953":{"id":"/docs/connectors/sources/source-8","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Source connector config (connectors/random.toml):"},"1954":{"id":"/docs/connectors/sources/source-9","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Configuration properties can be overridden using environment variables. The pattern follows: IGGY_CONNECTORS_SOURCE_[KEY]_[PROPERTY]"},"1955":{"id":"/docs/connectors/sources/source-10","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"For example, to override the enabled property for a source with ID random:"},"1956":{"id":"/docs/connectors/sources/source-11","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's implement the example source connector, which will simply generate the N random messages depending on the count specified in the configuration."},"1957":{"id":"/docs/connectors/sources/source-12","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Additionally, our source connector will have its own state, which can be used e.g. to track the overall progress or store some relevant information when producing the data from the actual external sources or tooling."},"1958":{"id":"/docs/connectors/sources/source-13","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Keep in mind, that the produced messages will be sent further to the specified stream, however it's already the responsibility of the runtime to handle the delivery."},"1959":{"id":"/docs/connectors/sources/source-14","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Also, when implementing the source connector, make sure to use the source_connector! macro to expose the FFI interface and allow the connector runtime to register the source with the runtime."},"1960":{"id":"/docs/connectors/sources/source-15","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And finally, each source should have its own, custom configuration, which is passed along with the unique plugin ID and optional state via expected new() method."},"1961":{"id":"/docs/connectors/sources/source-16","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's start by defining the internal state and the public source connector along with its own configuration."},"1962":{"id":"/docs/connectors/sources/source-17","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At this point, we can expose the required new() method, which will be used by the runtime to create a new instance of the source connector. The id is assigned by the runtime, and represents the unique identifier of the source connector. The state is an optional connector state (e.g. persisted in the local file), which will be provided by the runtime, given that the connector has persisted its own state before the runtime was restarted."},"1963":{"id":"/docs/connectors/sources/source-18","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"We can invoke the expected macro to expose the FFI interface and allow the connector runtime to register the source within the runtime."},"1964":{"id":"/docs/connectors/sources/source-19","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At a bare minimum, we need to add the following dependencies to the Cargo.toml file to compile the plugin at all:"},"1965":{"id":"/docs/connectors/sources/source-20","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"dashmap"},"1966":{"id":"/docs/connectors/sources/source-21","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"once_cell"},"1967":{"id":"/docs/connectors/sources/source-22","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tracing"},"1968":{"id":"/docs/connectors/sources/source-23","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Before we make use of the Source trait, let's define the internal payload of the message that will be produced (e.g. as if it was pulled from some external database or so)."},"1969":{"id":"/docs/connectors/sources/source-24","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Now, let's implement the Source trait for our RandomSource struct. We'll assume that the amount of messages (provided in the config), will be generated every 100ms to mimic the behavior of a real-world external source. On top of this, we'll also keep track of the current ID of the last message produced and return the state along with the ProducedMessages - the state in this case, will be just a binary encoded number, but it can be anything else, including the complex structs."},"1970":{"id":"/docs/connectors/sources/source-25","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"As you can see, the ProducedMessage can be customized to fit your needs, as all the fields will be directly mapped to the existing Iggy message struct."},"1971":{"id":"/docs/connectors/sources/source-26","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"It's also important to note, that the supported format(s) might vary depending on the connector implementation. For example, you might use JSON as the payload format, which can be then easily parsed and processed by downstream components such as data transforms, but at the same time, you could support the other formats and let the user decide which one to use."},"1972":{"id":"/docs/connectors/sources/source-27","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"While the final schema of messages (that will be appended to the Iggy stream), can be controlled with the built-in configuration (the particular StreamEncoder will be used), keep in mind, that it might be sometimes difficult/impossible e.g. to transform one format to another e.g. JSON to SBE or so, and in such a case, the produced messages will be ignored."},"1973":{"id":"/docs/connectors/sources/source-28","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Eventually, compile the source code and create a separate connector configuration file in the connectors directory (as specified in the main runtime config.toml). Make sure that path points to the existing plugin."},"1974":{"id":"/docs/connectors/sources/source-29","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And before starting the runtime, do not forget to create the specified stream and topic e.g. via Iggy CLI."},"1975":{"id":"/docs/connectors/sources/source-30","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And that's all, enjoy using the source connector!"},"1976":{"id":"/docs/connectors/sources/source-31","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On a side note, if you'd like to process the messages consumed from the Iggy stream instead, you can implement your own Sink connector too :)"},"1977":{"id":"/docs/sdk/cpp/intro","page_id":"/docs/sdk/cpp/intro","type":"page","content":"C++ SDK (WIP)","breadcrumbs":["Documentation","SDK","C++"],"tags":[],"url":"/docs/sdk/cpp/intro"},"1978":{"id":"/docs/sdk/cpp/intro-0","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#quick-start","content":"Quick start"},"1979":{"id":"/docs/sdk/cpp/intro-1","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#connection-strings","content":"Connection strings"},"1980":{"id":"/docs/sdk/cpp/intro-2","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#building-from-source","content":"Building from source"},"1981":{"id":"/docs/sdk/cpp/intro-3","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#current-status","content":"Current status"},"1982":{"id":"/docs/sdk/cpp/intro-4","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro","content":"The Iggy C++ SDK is a work in progress. It wraps the Rust SDK via CXX/FFI, which means it can access all transport protocols (TCP, QUIC, HTTP, WebSocket) through connection strings. The source code is available at github.com/apache/iggy/tree/master/foreign/cpp."},"1983":{"id":"/docs/sdk/cpp/intro-5","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro","content":"This SDK is not yet published to any package registry. To use it, build from source using CMake."},"1984":{"id":"/docs/sdk/cpp/intro-6","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#connection-strings","content":"The C++ SDK supports the same connection string format as the Rust SDK:"},"1985":{"id":"/docs/sdk/cpp/intro-7","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#connection-strings","content":"When an empty string or plain address is passed to new_connection(), it defaults to TCP."},"1986":{"id":"/docs/sdk/cpp/intro-8","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#building-from-source","content":"The C++ SDK uses CMake and depends on the Rust SDK being compiled first (via CXX bridge). See the build instructions in the repository for details."},"1987":{"id":"/docs/sdk/cpp/intro-9","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#current-status","content":"The SDK provides low-level access to stream, topic, and client management operations. Message sending and polling, consumer groups, and higher-level abstractions are being developed. Contributions are welcome."},"1988":{"id":"