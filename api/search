 to the CA file to use for the TLS connection (default: None)"},"2511":{"id":"/docs/sdk/rust/high-level-sdk-18","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"reconnection_retries - the number of retries to establish the connection (default: unlimited)"},"2512":{"id":"/docs/sdk/rust/high-level-sdk-19","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"reconnection_interval - the interval between the reconnection attempts (default: 1s)"},"2513":{"id":"/docs/sdk/rust/high-level-sdk-20","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"reestablish_after - the time to wait before reestablishing the connection (default: 5s)"},"2514":{"id":"/docs/sdk/rust/high-level-sdk-21","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"heartbeat_interval - the interval between the heartbeat messages (default: 5s)"},"2515":{"id":"/docs/sdk/rust/high-level-sdk-22","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"nodelay - whether to use the TCP_NODELAY option or not (default: false)"},"2516":{"id":"/docs/sdk/rust/high-level-sdk-23","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"For QUIC, the connection string is parsed with the following options:"},"2517":{"id":"/docs/sdk/rust/high-level-sdk-24","page_id":"/docs/sdk/rust/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/rust/high-level-sdk#connection-string","content":"response_buffer_size - the size of the response buffer (default: 10_000_000)"},"2518":{"id":"/docs/sdk/rust/high-level-sdk-25","page_id":"/docs/sdk/rust/high-level-sdk",